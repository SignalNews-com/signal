# Copy to .env and fill in real values there. Never commit real credentials to this file.
# MongoDB Atlas database, or a local replica set (transactions are required).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/signal
# Generate at least 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-hex-characters
# Required only while creating the first administrator through Postman. Remove after use.
BOOTSTRAP_ADMIN_KEY=replace-with-a-long-random-value
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Public site address, used for canonical URLs, sitemaps, RSS and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set only behind a trusted reverse proxy that overwrites x-forwarded-for.
TRUST_PROXY=false

# SEO (optional): search console verification codes and the publication's X/Twitter handle.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# NEXT_PUBLIC_TWITTER_HANDLE=@signal

# First-party article analytics. Consent is required unless explicitly configured otherwise.
ANALYTICS_ENABLED=true
# required (default) | optional. Denial, DNT and Global Privacy Control always win.
# Review your applicable consent requirements before choosing optional.
ANALYTICS_CONSENT_MODE=required
# unknown (default) | vercel. vercel also requires the platform-managed VERCEL=1.
# Never set VERCEL=1 on a publicly reachable non-Vercel origin to trust browser headers.
ANALYTICS_GEO_PROVIDER=unknown
# No GA4 is currently installed. Future Data API credentials belong only on the server.
# GA4_PROPERTY_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
